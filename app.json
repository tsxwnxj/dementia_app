{
  "expo": {
    "name": "dementia_app",
    "slug": "dementia_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "dementia-app",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.junseojang.dementiaapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "손 협응 체조 동작 감지를 위해 카메라가 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "산책 중 운동량 측정과 주변 산책 코스 추천을 위해 위치 정보가 필요합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "산책 중 백그라운드에서도 경로를 기록하기 위해 위치 정보가 필요합니다."
      },
      "appleTeamId": "GKDZVMV574"
    },
    "android": {
      "package": "com.junseojang.dementiaapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      "expo-notifications",
      "./plugins/withGestureModel",
      "expo-apple-authentication",
      
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "산책 중 운동량 측정과 주변 산책 코스 추천을 위해 위치 정보가 필요합니다.",
          "locationAlwaysAndWhenInUsePermission": "산책 중 백그라운드에서도 경로를 기록하기 위해 위치 정보가 필요합니다.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.381761400205-es0vjv4cgnam2291628e57e25eg5tf7l"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "e762d1d9bb4d6747b68bef981907a99a"
        }
      ]
    ],
    "assetBundlePatterns": [
      "assets/**"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4f2c6dd5-6cc7-454f-b9d8-c10a03acb5f2"
      }
    }
  }
}